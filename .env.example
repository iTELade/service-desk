# Publiczny adres reverse proxy. Bez ścieżki i końcowego ukośnika.
APP_URL=https://help.example.com
DESK_STACK_NAME=service-desk
DESK_CONTAINER_NAME=service-desk
DESK_DATA_VOLUME=service-desk-data
DESK_CONTROL_VOLUME=service-desk-control
DESK_BACKUP_VOLUME=service-desk-backups
PROXY_NETWORK=nginx-proxy-manager_default
# Konfiguracja firmy, logo, administratora i SMTP znajduje się w panelu WWW.
# Nie kopiuj tego pliku na istniejące .env podczas aktualizacji.
